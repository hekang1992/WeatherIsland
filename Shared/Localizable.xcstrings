          "stringUnit" : {
            "state" : "translated",
            "value" : "Original procedural paintings evoke landscapes; they do not depict actual city views."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tranh gốc được vẽ bằng chương trình để gợi cảnh sơn thủy, không tái hiện cảnh thật của thành phố."
